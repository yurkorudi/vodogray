msgid "A hotel where comfort meets the warmth of home"
msgstr "Готель, де комфорт поєднується з домашнім затишком"

msgid "Cozy rooms, delicious cuisine, and hospitality in the heart of Kyiv"
msgstr "Приємні номери, смачна кухня та гостинність у серці Києва"

msgid "View Cottages"
msgstr "Переглянути номери"

